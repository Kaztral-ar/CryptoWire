# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
SUBMISSION_CHANNEL_ID=
APPROVAL_CHANNEL_ID=

# Comma-separated Discord user IDs
ADMIN_USER_IDS=
ALLOWED_SUBMITTER_IDS=

# Encryption key for credentials entered through /set_api_key.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value in your hosting provider's secret/environment settings.
CRYPTOWIRE_SECRET_KEY=
BINANCE_SQUARE_SECRET_FILE=storage/binance_square_api_key.enc

# Optional legacy environment-based credential (leave empty when using /set_api_key).
BINANCE_SQUARE_OPENAPI_KEY=

# Application
DATABASE_URL=sqlite:///cryptowire.db
LOG_LEVEL=INFO
